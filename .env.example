# Backend (zelta_backend). In production set ALLOWED_ORIGINS on the backend to this site's origin.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Firebase web app config (public values)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Sample-data mode with no backend or login. Labelled in the UI. Never set in production.
# NEXT_PUBLIC_DEMO=1
